 extern RspUcodeFunc aspMain_run;
 
+// N64 adaptativo: microcódigos além do áudio padrão, recompilados por RSPRecomp a partir do que a descoberta achou
+// (adapt_ucodes.inc, gerado). Cada um é reconhecido pelo FNV-1a dos primeiros 0x100 bytes do código (ordem do N64).
+extern "C" uint8_t* adapt_rdram;
+struct AdaptUcode { uint64_t hash; RspUcodeFunc* func; };
+#include "adapt_ucodes.inc"
+
+static uint64_t adapt_ucode_hash(uint32_t addr) {
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (uint32_t i = 0; i < 0x100; i += 4) {
+        uint32_t w = *(uint32_t*)(adapt_rdram + RECOMP_RDRAM_OFFSET((gpr)(int32_t)(addr + i)));
+        for (int b = 3; b >= 0; b--) { h ^= (w >> (b * 8)) & 0xFF; h *= 0x100000001b3ULL; }
+    }
+    return h;
+}
+
